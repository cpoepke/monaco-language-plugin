{
  "name": "@mlp/lsp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Node WebSocket bridge that owns language-server processes and serves Monaco clients.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mlp-bridge": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mlp/protocol": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "typescript-language-server": "^5.3.0"
  }
}
