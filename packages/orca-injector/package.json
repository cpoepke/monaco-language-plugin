{
  "name": "@mlp/orca-injector",
  "version": "0.1.0",
  "private": true,
  "description": "Classic script injected into Orca's renderer: captures Monaco and boots the LSP client against the plugin-hosted bridge.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./injector.js": "./dist/injector.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "tsup && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@mlp/monaco-lsp-client": "workspace:*",
    "@mlp/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "happy-dom": "^20.0.0",
    "monaco-editor": "0.55.1",
    "playwright-core": "1.56.1",
    "vite": "^7.3.0"
  }
}
